# ===== Database =====
# Postgres connection string (Supabase / Neon / 本地 Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/skillsupermarket

# ===== GitHub =====
# Personal Access Token: https://github.com/settings/tokens
# 权限: public_repo (只读)
# 不填也能用，但会卡在 60 次/小时限流
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ===== LLM Judge (用于自动评测) =====
# DeepSeek 推荐，便宜; 备选: OPENAI_API_KEY / ANTHROPIC_API_KEY
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 每次 6 小时流水线最多补齐的无报告项目数；范围 0-5，0 表示暂停后台补齐
EVALUATION_COVERAGE_BATCH=5

# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# OPENAI_JUDGE_MODEL=gpt-4.1-mini
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_JUDGE_MODEL=claude-haiku-4-5

# ===== npm Registry (可选) =====
# 默认走公共 registry, 无需 token
# NPM_REGISTRY=https://registry.npmjs.org

# ===== PyPI (可选) =====
# 默认走公共 simple index, 无需 token
# PYPI_INDEX=https://pypi.org/simple

# ===== 应用配置 =====
NEXT_PUBLIC_APP_NAME=Skill Supermarket
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 搜索引擎 Canonical、Sitemap 与公开徽章使用的生产域名；线上必须为 HTTPS
NEXT_PUBLIC_SITE_URL=https://skillsupermarket.com
# GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxx
# BAIDU_SITE_VERIFICATION=xxxxxxxxxxxxxxxx
# 生产链路检查使用的公开真实评测案例；默认 GitHub 官方 MCP Server
# SEO_CASE_SLUG=githubgithub-mcp-server

# ===== 用户系统 =====
# 生产环境必须使用 32 字节以上随机密钥，例如: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# ===== 免费额度与反滥用 =====
# 对 IP 等来源标识做不可逆 HMAC；生产环境建议使用独立随机密钥
ABUSE_HASH_SECRET=replace-with-an-independent-random-secret
# 同一网络下所有免费账号共享的周资源池，兼顾家庭/小团队并限制批量小号
FREE_NETWORK_WEEKLY_LIMIT=20
