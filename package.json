{
  "name": "skill-supermarket",
  "version": "0.1.0",
  "private": true,
  "description": "AI Skill 超市 - 发现、评测、跟踪 Claude Skills / MCP Servers / Agent Packs",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint app components lib scripts data --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:evaluation": "tsx --test tests/evaluation.test.ts tests/evaluation-scoring.test.ts tests/evaluation-cache.test.ts tests/evaluation-queue.test.ts tests/judge.test.ts tests/evaluation-diagram.test.tsx tests/auth.test.ts tests/admin.test.ts tests/proxy.test.ts tests/quota.test.ts tests/skill-classification.test.ts tests/skill-evaluation-source.test.ts tests/skill-source-identity.test.ts tests/traffic.test.ts tests/sitemap.test.ts tests/guides.test.ts tests/indexnow.test.ts tests/release-retention.test.ts",
    "test:scoring": "tsx --test tests/evaluation-scoring.test.ts tests/judge.test.ts",
    "benchmark:diagrams": "tsx scripts/benchmark-diagram-recovery.ts",
    "evaluate:cases": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--conditions=react-server\" tsx scripts/evaluate-cases.ts",
    "prepare:case-judgments": "tsx scripts/prepare-case-judgments.ts",
    "apply:case-judgments": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--conditions=react-server\" tsx scripts/apply-case-judgments.ts",
    "test:rankings": "tsx --test tests/ranker.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:baseline:legacy": "tsx scripts/baseline-legacy-migrations.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "collect": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--conditions=react-server\" tsx scripts/collect.ts",
    "cache:readmes": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--conditions=react-server\" tsx scripts/cache-readmes.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "coverage:enqueue": "tsx scripts/enqueue-evaluation-coverage.ts",
    "types:reclassify": "tsx scripts/reclassify-github-skills.ts",
    "worker:evaluate": "tsx scripts/evaluation-worker.ts",
    "rank": "tsx scripts/rank.ts",
    "indexnow": "tsx scripts/submit-indexnow.ts",
    "releases:prune": "node scripts/prune-releases.mjs",
    "growth:report": "tsx scripts/growth-report.ts",
    "admin:promote": "tsx scripts/promote-super-admin.ts",
    "seo:check": "tsx scripts/seo-check.ts",
    "seed": "tsx data/seed-skills.ts",
    "snapshot": "tsx scripts/export-snapshot.ts",
    "sync": "bash scripts/auto-sync.sh"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "better-auth": "^1.6.27",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.460.0",
    "next": "16.3.0",
    "pg": "^8.13.1",
    "postgres": "^3.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^9.0.1",
    "recharts": "^2.13.3",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
