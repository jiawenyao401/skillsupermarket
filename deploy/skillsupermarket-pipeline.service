[Unit]
Description=Skill Supermarket scheduled collection and ranking pipeline
After=network-online.target postgresql.service pm2-root.service
Wants=network-online.target
ConditionPathExists=/opt/skillsupermarket/package.json

[Service]
Type=oneshot
WorkingDirectory=/opt/skillsupermarket
Environment=NODE_ENV=production
Environment=PROJECT_DIR=/opt/skillsupermarket
Environment=LOG_DIR=/var/log/skillsupermarket
ExecStart=/usr/bin/bash /opt/skillsupermarket/scripts/daily-pipeline.sh
TimeoutStartSec=30min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/skillsupermarket /opt/releases /var/log/skillsupermarket /run/lock

[Install]
WantedBy=multi-user.target
