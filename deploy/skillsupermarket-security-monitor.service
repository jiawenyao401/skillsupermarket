[Unit]
Description=Skill Supermarket host integrity and malware signal monitor
After=network-online.target pm2-root.service
Wants=network-online.target
ConditionPathExists=/opt/skillsupermarket/scripts/security-monitor.sh

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/skillsupermarket
Environment=PROJECT_DIR=/opt/skillsupermarket
Environment=SECURITY_STATE_DIR=/var/lib/skillsupermarket-security
ExecStart=/usr/bin/bash /opt/skillsupermarket/scripts/security-monitor.sh check
TimeoutStartSec=4min
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/opt/skillsupermarket -/root/.ssh /home
ReadWritePaths=/var/lib/skillsupermarket-security
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=false
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
